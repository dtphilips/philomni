# ─── Payment Configuration ────────────────────────────────────────────────────
# Set provider: stripe | paystack | flutterwave
VITE_PAYMENT_PROVIDER=paystack

# Stripe (for US / Canada / UK / Europe)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Paystack (for Nigeria)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_...

# Flutterwave (for Africa)
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...

# ─── Stripe Subscription Price IDs ───────────────────────────────────────────
# Create these in Stripe Dashboard → Products:
#   Pro Monthly    $29.99/mo → copy Price ID here
#   Pro Annual     $299/yr   → copy Price ID here
#   Pro Max Monthly $49.99/mo → copy Price ID here
#   Pro Max Annual  $479/yr   → copy Price ID here
VITE_STRIPE_PRO_MONTHLY=price_xxx
VITE_STRIPE_PRO_ANNUAL=price_xxx
VITE_STRIPE_PROMAX_MONTHLY=price_xxx
VITE_STRIPE_PROMAX_ANNUAL=price_xxx

# ─── Supabase Edge Function Secrets (set in Supabase Dashboard → Vault) ──────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...  (from Stripe Dashboard → Webhooks)
# PAYSTACK_SECRET_KEY=sk_live_...
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
# SUPABASE_SERVICE_ROLE_KEY=...   (auto-available in edge functions)
# SITE_URL=https://philomni.com

# ─── Stripe Webhook Setup ────────────────────────────────────────────────────
# In Stripe Dashboard → Developers → Webhooks:
# Endpoint URL: https://ylqfnxvbqqwjxdfbjwjk.supabase.co/functions/v1/stripe-webhook
# Events to listen for:
#   checkout.session.completed
#   invoice.payment_succeeded
#   invoice.payment_failed
#   customer.subscription.deleted
#   customer.subscription.updated
# Copy the Signing Secret → add as STRIPE_WEBHOOK_SECRET in Supabase Vault

# ─── Friday Payout Cron Setup ────────────────────────────────────────────────
# Supabase Dashboard → Database → Cron Jobs → Create:
# Name:     weekly-creator-payouts
# Schedule: 0 9 * * 5   (09:00 UTC every Friday)
# Command:
#   SELECT net.http_post(
#     url := 'https://ylqfnxvbqqwjxdfbjwjk.supabase.co/functions/v1/process-payouts',
#     headers := '{"Authorization":"Bearer <service_role_key>"}'
#   );
