{
  "name": "GroupPost",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID of the group"
    },
    "author_id": {
      "type": "string",
      "description": "User ID of post author"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Post content or discussion topic"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "media_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "video"
      ],
      "default": "text"
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "comment_count": {
      "type": "number",
      "default": 0
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "group_id",
    "author_id",
    "content"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}