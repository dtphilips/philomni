{
  "name": "Post",
  "type": "object",
  "properties": {
    "author_id": {
      "type": "string",
      "description": "User ID of the post author"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "author_headline": {
      "type": "string"
    },
    "author_role": {
      "type": "string"
    },
    "author_verified": {
      "type": "boolean",
      "default": false
    },
    "content": {
      "type": "string",
      "description": "Text content of the post"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Images, videos, or other media"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "none",
        "image",
        "video",
        "link",
        "mixed"
      ],
      "default": "none"
    },
    "link_url": {
      "type": "string"
    },
    "link_preview": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "image": {
          "type": "string"
        }
      }
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tagged_users": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "comment_count": {
      "type": "number",
      "default": 0
    },
    "share_count": {
      "type": "number",
      "default": 0
    },
    "bookmark_count": {
      "type": "number",
      "default": 0
    },
    "is_boosted": {
      "type": "boolean",
      "default": false
    },
    "is_repost": {
      "type": "boolean",
      "default": false
    },
    "original_post_id": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "followers",
        "private"
      ],
      "default": "public"
    }
  },
  "required": [
    "content",
    "author_id"
  ]
}