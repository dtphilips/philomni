{
  "name": "WorkflowExecution",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string",
      "description": "ID of the ContentWorkflow"
    },
    "workflow_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ],
      "default": "running"
    },
    "steps_completed": {
      "type": "number",
      "default": 0
    },
    "total_steps": {
      "type": "number"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "description": "Results from each step"
    },
    "error_message": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "workflow_id",
    "workflow_name",
    "total_steps"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}