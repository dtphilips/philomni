{
  "name": "Event",
  "type": "object",
  "properties": {
    "organizer_id": {
      "type": "string"
    },
    "organizer_name": {
      "type": "string"
    },
    "organizer_avatar": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "virtual",
        "in_person",
        "hybrid"
      ],
      "default": "virtual"
    },
    "category": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string"
    },
    "meeting_url": {
      "type": "string"
    },
    "max_attendees": {
      "type": "number"
    },
    "attendee_count": {
      "type": "number",
      "default": 0
    },
    "is_free": {
      "type": "boolean",
      "default": true
    },
    "price": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "live",
        "ended",
        "cancelled"
      ],
      "default": "upcoming"
    }
  },
  "required": [
    "title",
    "organizer_id",
    "starts_at"
  ]
}