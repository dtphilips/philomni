{
  "name": "GroupMember",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID of the group"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the member"
    },
    "user_name": {
      "type": "string"
    },
    "user_avatar": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "moderator",
        "member"
      ],
      "default": "member",
      "description": "Member role in the group"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "banned"
      ],
      "default": "active",
      "description": "Membership status"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "group_id",
    "user_id"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}