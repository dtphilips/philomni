{
  "name": "WorkspacePresence",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_avatar": {
      "type": "string"
    },
    "cursor_position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "description": "Live cursor position for collaborative editing"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "idle",
        "away"
      ],
      "default": "active"
    },
    "last_activity": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workspace_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}