{
  "name": "Podcast",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "creator_avatar": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "total_episodes": {
      "type": "number",
      "default": 0
    },
    "followers": {
      "type": "number",
      "default": 0
    },
    "average_rating": {
      "type": "number"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "creator_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.creator_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "data.creator_id": "{{user.id}}"
    },
    "delete": {
      "data.creator_id": "{{user.id}}"
    }
  }
}