{
  "name": "UserReview",
  "type": "object",
  "properties": {
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_avatar": {
      "type": "string"
    },
    "reviewee_id": {
      "type": "string",
      "description": "The user being reviewed"
    },
    "application_id": {
      "type": "string",
      "description": "The application that led to this gig"
    },
    "job_title": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "description": "1\u20135 star rating"
    },
    "feedback": {
      "type": "string"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "client",
        "collaborator",
        "colleague",
        "other"
      ],
      "default": "client"
    }
  },
  "required": [
    "reviewer_id",
    "reviewee_id",
    "rating"
  ],
  "rls": {
    "create": {
      "data.reviewer_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "data.reviewer_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "data.reviewee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}