{
  "name": "CollaborativeWorkspace",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "User who created the workspace"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "video",
        "blog",
        "script",
        "content"
      ],
      "description": "Type of collaborative project"
    },
    "content_id": {
      "type": "string",
      "description": "ID of the associated content/project"
    },
    "collaborators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "user_avatar": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "editor",
              "viewer"
            ]
          },
          "joined_at": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "owner_id",
    "name",
    "project_type"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "data.owner_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_id": "{{user.id}}"
    }
  }
}