{
  "name": "Booking",
  "type": "object",
  "properties": {
    "professional_id": {
      "type": "string"
    },
    "professional_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "session_type": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "duration_minutes": {
      "type": "number"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "stripe_payment_intent": {
      "type": "string"
    },
    "google_calendar_event_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "professional_id",
    "client_id",
    "session_type",
    "scheduled_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.professional_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.professional_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.professional_id": "{{user.id}}"
        }
      ]
    },
    "delete": {}
  }
}